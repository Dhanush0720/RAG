# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lexirag?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# AI microservice
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
AI_SERVICE_TIMEOUT_MS=300000

# Email Service (SMTP) - Optional. If omitted, simulated reset links are output in server logs.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LexiRAG <noreply@lexirag.ai>"
