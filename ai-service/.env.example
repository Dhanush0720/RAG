# Internal auth - must match backend/.env AI_SERVICE_TOKEN
INTERNAL_TOKEN=shared_internal_secret_change_me

# LLM provider: "gemini" or "openai_compatible"
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenAI-compatible (OpenAI, Groq, local vLLM, etc.)
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# Embeddings
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Vector store
VECTOR_STORE_DIR=./vector_store

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
